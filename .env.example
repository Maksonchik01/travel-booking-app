# Копіюй у .env і заповни. Реальні значення ніколи не комітимо.

# --- загальне ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000

# --- інфраструктура ---
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets
DATABASE_URL=postgresql+asyncpg://tickets:tickets@localhost:5432/tickets
REDIS_URL=redis://localhost:6379/0

# --- моніторинг ---
SENTRY_DSN=

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL_PARSER=claude-haiku-5-5
LLM_MODEL_EXPLAINER=claude-sonnet-5-5
LLM_MAX_CALLS_PER_SEARCH=3

# --- провайдери даних ---
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- авторизація (Google OAuth, етап пізніше) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# --- сповіщення (етап 7) ---
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
