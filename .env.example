# Копіюй у .env і заповни. Реальні значення ніколи не комітимо.

# --- загальне ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000

# --- інфраструктура ---
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets
DATABASE_URL=postgresql+asyncpg://tickets:tickets@localhost:5432/tickets
REDIS_URL=redis://localhost:6379/0

# --- моніторинг ---
# Sentry (лише помилки, без персональних даних). Порожньо — вимкнено.
SENTRY_DSN=
# DSN проєкту вебу: задається у Vercel (локально — apps/web/.env.local)
NEXT_PUBLIC_SENTRY_DSN=
# Необов'язково: читабельні стеки у вебі (завантаження source maps під час збірки на Vercel)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- ліміти запитів на відвідувача за годину (core/rate_limit.py) ---
# Спільний секрет веб ↔ API (той самий у Vercel і Render): лише з ним API вірить IP
# відвідувача з X-Client-IP. Без нього ліміт рахується на сервер Vercel загалом.
# Згенерувати: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
RATE_LIMIT_SEARCH_PER_HOUR=40
# ADR 0056: поїздка / «знайти дешевше» / оновлення цін; перевірка продавців і тарифів;
# дешеві читання (календар, історія цін, місця). Увійшов — кошик акаунта × множник.
RATE_LIMIT_HEAVY_PER_HOUR=15
RATE_LIMIT_CHECK_PER_HOUR=60
RATE_LIMIT_LOOKUP_PER_HOUR=600
RATE_LIMIT_ACCOUNT_MULTIPLIER=2
MAX_CONCURRENT_SEARCHES=3
RATE_LIMIT_AI_PER_HOUR=90
RATE_LIMIT_AUTH_PER_HOUR=20
RATE_LIMIT_CLICKS_PER_HOUR=200
# Анонімні події аналітики (модуль 19) — окремий ліміт від кліків «Забронювати»
RATE_LIMIT_EVENTS_PER_HOUR=600

# --- LLM (DeepSeek, ADR 0007) ---
# off — ШІ-функції вимкнені; mock — детерміновані відповіді без ключа; deepseek — живі.
LLM_PROVIDER=off
DEEPSEEK_API_KEY=
LLM_MODEL_PARSER=deepseek-flash
LLM_MODEL_EXPLAINER=deepseek-v4-pro
LLM_MODEL_ASSISTANT=deepseek-flash
LLM_MAX_CALLS_PER_SEARCH=3
LLM_MAX_CALLS_PER_CHAT_TURN=6
LLM_TIMEOUT_S=45
# Ліміт витрат на ШІ для всіх користувачів (USD, ADR 0056); порожньо — без ліміту.
LLM_BUDGET_DAILY_USD=2
LLM_BUDGET_MONTHLY_USD=20
LLM_CACHE_TTL_S=86400
# Ціни моделей і години пік: tickets_api/llm/pricing.toml (або свій файл)
LLM_PRICING_PATH=
LLM_PROMPTS_DIR=

# --- провайдери даних ---
# Через кому. Пошук: mock, travelpayouts (кеш 2–7 днів), serpapi (живі ціни Google Flights),
# scrapedo (та сама видача Google Flights через scrape.do, ADR 0043).
# Календар: mock, travelpayouts. Реальні дані (модуль 22, ADR 0041): FLIGHT_PROVIDERS=serpapi,travelpayouts
# (живі ціни + продавці з кешу Aviasales, однаковий рейс — одна картка), CALENDAR_PROVIDERS=travelpayouts
FLIGHT_PROVIDERS=mock
CALENDAR_PROVIDERS=mock
# Житло: mock або scrapedo — Google Hotels (фото, опис, продавці; ADR 0044). Кредити спільні з
# перельотами: пошук — 10, сторінка об'єкта (тарифи) — 10; повтор за 30 хв — з кешу.
STAY_PROVIDERS=mock
PROVIDER_TIMEOUT_S=8
PROVIDER_CACHE_TTL_S=1800
# ADR 0058: кешовані ціни Travelpayouts і видача житла (scrape.do) живуть у кеші довше.
CACHED_SOURCE_TTL_S=10800
STAY_CACHE_TTL_S=3600
# Порожньо — вбудований tickets_api/scoring/config.toml
SCORING_CONFIG_PATH=
# Порожньо — вбудований tickets_api/scoring/stays.toml
STAY_SCORING_CONFIG_PATH=
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# SerpApi: безкоштовно 250 запитів/міс. Ключ іде в URL — логи httpx приглушено.
SERPAPI_KEY=
SERPAPI_MAX_REQUESTS_PER_SEARCH=4
# Гнучкі дати: скільки найдешевших кешованих пар дат перевіряти наживо (0 — не перевіряти)
FLEX_LIVE_DATE_PAIRS=2
SERPAPI_RETURNS_PER_DATE=2
SERPAPI_TIMEOUT_S=30
# Країна Google (gl), напр. pl; порожньо — за замовчуванням Google
SERPAPI_MARKET=
# scrape.do (ADR 0043): запит — 10 кредитів, безкоштовно 1000/міс; туди-назад — 2 запити
# (два квитки в один бік). Токен іде в URL лише з API — у веб не передаємо.
SCRAPEDO_TOKEN=
SCRAPEDO_MAX_REQUESTS_PER_SEARCH=2
SCRAPEDO_TIMEOUT_S=30
# Бюджет платних API (ADR 0055): ліміти SkyPack, спільні для всіх процесів (Redis).
# Порожньо — без ліміту. SerpApi — у пошуках, scrape.do — у кредитах (запит = 10).
SERPAPI_BUDGET_HOURLY=40
SERPAPI_BUDGET_DAILY=25
SERPAPI_BUDGET_MONTHLY=240
SERPAPI_COST_PER_REQUEST_USD=0.025
SCRAPEDO_CREDITS_PER_REQUEST=10
SCRAPEDO_BUDGET_HOURLY=200
SCRAPEDO_BUDGET_DAILY=150
SCRAPEDO_BUDGET_MONTHLY=950
SCRAPEDO_COST_PER_CREDIT_USD=0.000116
# Необов'язкові дорогі операції зупиняються на цій частці ліміту; попередження в лог — на цій.
API_BUDGET_OPTIONAL_SHARE=0.8
API_BUDGET_WARN_SHARE=0.8

# --- акаунти (ADR 0011) ---
# Google: Cloud Console → Credentials → OAuth client ID (Web application),
# Authorized redirect URI: <PUBLIC_WEB_URL>/api/auth/google/callback. Порожньо — без Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_TTL_DAYS=30
LOGIN_MAX_FAILURES=5

# --- алерти й сповіщення (етап 7, ADR 0010) ---
# Ціни для перевірок — кешоване джерело (travelpayouts або mock), НЕ serpapi (квота).
ALERT_PROVIDERS=mock
ALERT_CHECK_INTERVAL_HOURS=6
ALERT_MIN_HOURS_BETWEEN_NOTIFICATIONS=24
# Ліміти перевірок (ТЗ 11.4): різних пошуків за одну перевірку; підписок на власника
ALERT_MAX_SEARCHES_PER_RUN=300
ALERT_MAX_ACTIVE_PER_OWNER=20
# Адреса сайту для посилань у сповіщеннях
PUBLIC_WEB_URL=http://localhost:3000
# Порожньо — Telegram вимкнено (сповіщення лише в лог). Бот: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Порожньо — email вимкнено (листи лише в лог)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Публічний email для запитів щодо даних на /privacy, /terms (порожньо — рядка контакту немає).
# Веб читає його з apps/web/.env.local локально і з Environment Variables на Vercel.
CONTACT_EMAIL=
# Свіжість ціни (модуль 17.3): жива ціна старша за N хв і кешована старша за N днів —
# «варто перевірити» перед переходом до продавця
PRICE_LIVE_FRESH_MIN=30
PRICE_CACHED_STALE_DAYS=3

# Пошук місця біля житла (ADR 0049): OpenStreetMap Nominatim, без ключа. Не частіше 1 запиту/с,
# User-Agent із контактом застосунку. Свій екземпляр чи інший сумісний провайдер — змініть URL.
# GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=SkyPack/1.0 (+https://github.com/Maksonchik01/travel-booking-app)
