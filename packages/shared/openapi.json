{
  "openapi": "3.1.0",
  "info": {
    "title": "Tickets API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness: процес живий. Залежності не перевіряє.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "Readiness: перевіряє Postgres і Redis. 503, якщо хоч одна залежність недоступна.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/flights/search": {
      "post": {
        "tags": [
          "flights"
        ],
        "summary": "Search Flights",
        "description": "Пошук у всіх увімкнених провайдерах. Ціни кешовані: дивись collected_at / found_at.\n\nЗбій окремого провайдера не дає помилку — він видно в `providers[].status`.",
        "operationId": "search_flights_flights_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlightQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightSearchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/flights/calendar": {
      "get": {
        "tags": [
          "flights"
        ],
        "summary": "Price Calendar",
        "description": "Найнижча відома ціна на кожен день місяця (в один бік).",
        "operationId": "price_calendar_flights_calendar_get",
        "parameters": [
          {
            "name": "origin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$",
              "examples": [
                "WAW"
              ],
              "title": "Origin"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$",
              "examples": [
                "WAW"
              ],
              "title": "Destination"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "examples": [
                "2026-11"
              ],
              "title": "Month"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$",
              "default": "EUR",
              "title": "Currency"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/places": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "Search Places",
        "description": "Автодоповнення міст і аеропортів з локального довідника (без звернень до провайдерів).",
        "operationId": "search_places_places_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "examples": [
                "вар"
              ],
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 8,
              "title": "Limit"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "uk",
                "en"
              ],
              "type": "string",
              "default": "uk",
              "title": "Lang"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Place"
                  },
                  "title": "Response Search Places Places Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/status": {
      "get": {
        "tags": [
          "ai"
        ],
        "summary": "Ai Status",
        "operationId": "ai_status_ai_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ai/parse": {
      "post": {
        "tags": [
          "ai"
        ],
        "summary": "Parse Request",
        "description": "Текст природною мовою → структурований пошук (або одне уточнююче питання).",
        "operationId": "parse_request_ai_parse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/chat": {
      "post": {
        "tags": [
          "ai"
        ],
        "summary": "Chat",
        "description": "Репліка розмови з агентом. Сервер розмову не зберігає — її надсилає клієнт.",
        "operationId": "chat_ai_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/explain": {
      "post": {
        "tags": [
          "ai"
        ],
        "summary": "Explain Results",
        "description": "Пояснення найкращих варіантів пошуку. Числа — лише з результатів скорингу.",
        "operationId": "explain_results_ai_explain_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlightQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplainResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIStatus": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "provider": {
            "type": "string",
            "enum": [
              "off",
              "mock",
              "deepseek"
            ],
            "title": "Provider"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "provider"
        ],
        "title": "AIStatus"
      },
      "AdvisorOption": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "pros": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pros",
            "default": []
          },
          "cons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cons",
            "default": []
          },
          "risks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Risks",
            "default": []
          },
          "one_liner": {
            "type": "string",
            "title": "One Liner",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "AdvisorOption"
      },
      "AirlineFacet": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "offers": {
            "type": "integer",
            "title": "Offers"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "offers"
        ],
        "title": "AirlineFacet"
      },
      "Availability": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available",
            "default": false
          },
          "text": {
            "type": "string",
            "title": "Text",
            "default": ""
          }
        },
        "type": "object",
        "title": "Availability"
      },
      "CalendarDay": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Currency"
          },
          "stops": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Stops"
          },
          "airline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Airline"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Collected At"
          },
          "found_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Found At"
          },
          "found_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Found On"
          }
        },
        "type": "object",
        "required": [
          "date",
          "price",
          "currency",
          "source",
          "collected_at"
        ],
        "title": "CalendarDay",
        "description": "Найнижча відома ціна на конкретну дату вильоту."
      },
      "CalendarResult": {
        "properties": {
          "days": {
            "items": {
              "$ref": "#/components/schemas/CalendarDay"
            },
            "type": "array",
            "title": "Days"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderStatus"
            },
            "type": "array",
            "title": "Providers"
          }
        },
        "type": "object",
        "required": [
          "days",
          "providers"
        ],
        "title": "CalendarResult"
      },
      "ChatBody": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Messages"
          },
          "current_search": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FlightQuery"
              },
              {
                "type": "null"
              }
            ]
          },
          "home_airport": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z]{3}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Airport"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatBody"
      },
      "ChatReply": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fallback",
              "unavailable"
            ],
            "title": "Status"
          },
          "reply": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply"
          },
          "search": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FlightQuery"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ChatReply"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "title": "ChatTurn",
        "description": "Репліка розмови. Приходить від клієнта — для моделі це лише дані."
      },
      "CheckResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CheckResult"
      },
      "ExplainResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_options",
              "unavailable",
              "rejected"
            ],
            "title": "Status"
          },
          "explanation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Explanation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ExplainResult"
      },
      "Explanation": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "recommended_id": {
            "type": "string",
            "title": "Recommended Id"
          },
          "recommendation_reason": {
            "type": "string",
            "title": "Recommendation Reason",
            "default": ""
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/AdvisorOption"
            },
            "type": "array",
            "title": "Options",
            "default": []
          },
          "price_assessment": {
            "$ref": "#/components/schemas/Availability",
            "default": {
              "available": false,
              "text": ""
            }
          },
          "timing_advice": {
            "$ref": "#/components/schemas/Availability",
            "default": {
              "available": false,
              "text": ""
            }
          },
          "data_freshness_note": {
            "type": "string",
            "title": "Data Freshness Note",
            "default": ""
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "summary",
          "recommended_id"
        ],
        "title": "Explanation"
      },
      "FlightQuery": {
        "properties": {
          "origin": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Origin"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Destination"
          },
          "departure_date": {
            "type": "string",
            "format": "date",
            "title": "Departure Date"
          },
          "return_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Return Date"
          },
          "flex_days": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 0.0,
            "title": "Flex Days",
            "default": 0
          },
          "passengers": {
            "$ref": "#/components/schemas/Passengers",
            "default": {
              "adults": 1,
              "children": 0,
              "infants": 0
            }
          },
          "direct_only": {
            "type": "boolean",
            "title": "Direct Only",
            "default": false
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Currency",
            "default": "EUR"
          },
          "profile": {
            "type": "string",
            "enum": [
              "budget",
              "balanced",
              "time_is_money"
            ],
            "title": "Profile",
            "default": "balanced"
          },
          "origin_radius_km": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Origin Radius Km",
            "default": 0
          },
          "destination_radius_km": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Destination Radius Km",
            "default": 0
          },
          "filters": {
            "$ref": "#/components/schemas/OfferFilters",
            "default": {
              "airlines": [],
              "departure_periods": []
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin",
          "destination",
          "departure_date"
        ],
        "title": "FlightQuery"
      },
      "FlightSearchResult": {
        "properties": {
          "offers": {
            "items": {
              "$ref": "#/components/schemas/Offer"
            },
            "type": "array",
            "title": "Offers"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderStatus"
            },
            "type": "array",
            "title": "Providers"
          },
          "scoring": {
            "$ref": "#/components/schemas/ScoringResult"
          },
          "facets": {
            "$ref": "#/components/schemas/SearchFacets"
          }
        },
        "type": "object",
        "required": [
          "offers",
          "providers",
          "scoring",
          "facets"
        ],
        "title": "FlightSearchResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "Layover": {
        "properties": {
          "airport": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Airport"
          },
          "duration_min": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duration Min"
          },
          "overnight": {
            "type": "boolean",
            "title": "Overnight"
          },
          "self_transfer": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Self Transfer"
          }
        },
        "type": "object",
        "required": [
          "airport",
          "duration_min",
          "overnight",
          "self_transfer"
        ],
        "title": "Layover"
      },
      "Leg": {
