{
  "openapi": "3.1.0",
  "info": {
    "title": "Tickets API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness: процес живий. Залежності не перевіряє.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "Readiness: перевіряє Postgres і Redis. 503, якщо хоч одна залежність недоступна.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/flights/search": {
      "post": {
        "tags": [
          "flights"
        ],
        "summary": "Search Flights",
        "description": "Пошук у всіх увімкнених провайдерах. Ціни кешовані: дивись collected_at / found_at.\n\nЗбій окремого провайдера не дає помилку — він видно в `providers[].status`.",
        "operationId": "search_flights_flights_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlightQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightSearchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/flights/calendar": {
      "get": {
        "tags": [
          "flights"
        ],
        "summary": "Price Calendar",
        "description": "Найнижча відома ціна на кожен день місяця (в один бік).",
        "operationId": "price_calendar_flights_calendar_get",
        "parameters": [
          {
            "name": "origin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$",
              "examples": [
                "WAW"
              ],
              "title": "Origin"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$",
              "examples": [
                "WAW"
              ],
              "title": "Destination"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "examples": [
                "2026-11"
              ],
              "title": "Month"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$",
              "default": "EUR",
              "title": "Currency"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/places": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "Search Places",
        "description": "Автодоповнення міст і аеропортів з локального довідника (без звернень до провайдерів).",
        "operationId": "search_places_places_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "examples": [
                "вар"
              ],
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 8,
              "title": "Limit"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "uk",
                "en"
              ],
              "type": "string",
              "default": "uk",
              "title": "Lang"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Place"
                  },
                  "title": "Response Search Places Places Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AirlineFacet": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "offers": {
            "type": "integer",
            "title": "Offers"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "offers"
        ],
        "title": "AirlineFacet"
      },
      "CalendarDay": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Currency"
          },
          "stops": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Stops"
          },
          "airline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Airline"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Collected At"
          },
          "found_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Found At"
          },
          "found_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Found On"
          }
        },
        "type": "object",
        "required": [
          "date",
          "price",
          "currency",
          "source",
          "collected_at"
        ],
        "title": "CalendarDay",
        "description": "Найнижча відома ціна на конкретну дату вильоту."
      },
      "CalendarResult": {
        "properties": {
          "days": {
            "items": {
              "$ref": "#/components/schemas/CalendarDay"
            },
            "type": "array",
            "title": "Days"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderStatus"
            },
            "type": "array",
            "title": "Providers"
          }
        },
        "type": "object",
        "required": [
          "days",
          "providers"
        ],
        "title": "CalendarResult"
      },
      "CheckResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CheckResult"
      },
      "FlightQuery": {
        "properties": {
          "origin": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Origin"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Destination"
          },
          "departure_date": {
            "type": "string",
            "format": "date",
            "title": "Departure Date"
          },
          "return_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Return Date"
          },
          "flex_days": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 0.0,
            "title": "Flex Days",
            "default": 0
          },
          "passengers": {
            "$ref": "#/components/schemas/Passengers",
            "default": {
              "adults": 1,
              "children": 0,
              "infants": 0
            }
          },
          "direct_only": {
            "type": "boolean",
            "title": "Direct Only",
            "default": false
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Currency",
            "default": "EUR"
          },
          "profile": {
            "type": "string",
            "enum": [
              "budget",
              "balanced",
              "time_is_money"
            ],
            "title": "Profile",
            "default": "balanced"
          },
          "origin_radius_km": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Origin Radius Km",
            "default": 0
          },
          "destination_radius_km": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Destination Radius Km",
            "default": 0
          },
          "filters": {
            "$ref": "#/components/schemas/OfferFilters",
            "default": {
              "airlines": [],
              "departure_periods": []
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin",
          "destination",
          "departure_date"
        ],
        "title": "FlightQuery"
      },
      "FlightSearchResult": {
        "properties": {
          "offers": {
            "items": {
              "$ref": "#/components/schemas/Offer"
            },
            "type": "array",
            "title": "Offers"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderStatus"
            },
            "type": "array",
            "title": "Providers"
          },
          "scoring": {
            "$ref": "#/components/schemas/ScoringResult"
          },
          "facets": {
            "$ref": "#/components/schemas/SearchFacets"
          }
        },
        "type": "object",
        "required": [
          "offers",
          "providers",
          "scoring",
          "facets"
        ],
        "title": "FlightSearchResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "Layover": {
        "properties": {
          "airport": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Airport"
          },
          "duration_min": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duration Min"
          },
          "overnight": {
            "type": "boolean",
            "title": "Overnight"
          },
          "self_transfer": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Self Transfer"
          }
        },
        "type": "object",
        "required": [
          "airport",
          "duration_min",
          "overnight",
          "self_transfer"
        ],
        "title": "Layover"
      },
      "Leg": {
        "properties": {
          "origin": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Origin"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Destination"
          },
          "departure_at": {
            "type": "string",
            "format": "date-time",
            "title": "Departure At"
          },
          "arrival_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arrival At"
          },
          "duration_min": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Min"
          },
          "stops": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stops"
          },
          "segments": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Segment"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segments"
          },
          "layovers": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Layover"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Layovers"
          },
          "flight_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flight Number"
          }
        },
        "type": "object",
        "required": [
          "origin",
          "destination",
          "departure_at",
          "stops"
        ],
        "title": "Leg",
        "description": "Один напрямок подорожі (туди або назад)."
      },
      "Offer": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Currency"
          },
          "outbound": {
            "$ref": "#/components/schemas/Leg"
          },
          "inbound": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Leg"
              },
              {
                "type": "null"
              }
            ]
          },
          "airlines": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Airlines"
          },
          "details_level": {
            "type": "string",
            "enum": [
              "full",
              "summary"
            ],
            "title": "Details Level"
          },
          "baggage_included": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baggage Included"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Collected At"
          },
          "found_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Found At"
          },
          "found_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Found On"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "deep_link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deep Link"
          },
          "seller": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seller"
          },
          "reported_total_duration_min": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported Total Duration Min"
          },
          "stops": {
            "type": "integer",
            "title": "Stops",
            "readOnly": true
          },
          "total_duration_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Duration Min",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "source",
          "price",
          "currency",
          "outbound",
          "airlines",
          "details_level",
          "collected_at",
          "stops",
          "total_duration_min"
        ],
        "title": "Offer"
      },
      "OfferFilters": {
        "properties": {
          "max_stops": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Stops"
          },
          "airlines": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{2}$"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Airlines"
          },
          "departure_periods": {
            "items": {
              "type": "string",
              "enum": [
                "night",
                "morning",
                "afternoon",
                "evening"
              ]
            },
            "type": "array",
            "title": "Departure Periods"
          },
          "max_duration_hours": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 72.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Duration Hours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "OfferFilters",
        "description": "Фільтри видачі. Застосовуються ПІСЛЯ провайдерів: до запиту й кешу не входять.\n\nНевідоме значення (тривалість, авіакомпанія) не відсікає пропозицію — як і в\nскорингу, «невідомо» не означає «погано» (ADR 0004)."
      },
      "OfferScore": {
        "properties": {
          "offer_key": {
            "type": "string",
            "title": "Offer Key"
          },
          "breakdown": {
            "$ref": "#/components/schemas/ScoreBreakdown"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/ScoreWarning"
            },
            "type": "array",
            "title": "Warnings"
          },
          "pareto_optimal": {
            "type": "boolean",
            "title": "Pareto Optimal"
          }
        },
        "type": "object",
        "required": [
          "offer_key",
          "breakdown",
          "warnings",
          "pareto_optimal"
        ],
        "title": "OfferScore"
      },
      "Passengers": {
        "properties": {
          "adults": {
            "type": "integer",
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Adults",
            "default": 1
          },
          "children": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Children",
            "default": 0
          },
          "infants": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Infants",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Passengers"
      },
      "Pick": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "cheapest",
              "fastest",
              "balanced"
            ],
            "title": "Label"
          },
          "offer_key": {
            "type": "string",
            "title": "Offer Key"
          },
          "also": {
            "items": {
              "type": "string",
              "enum": [
                "cheapest",
                "fastest",
                "balanced"
              ]
            },
            "type": "array",
            "title": "Also",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "label",
          "offer_key"
        ],
        "title": "Pick"
      },
      "Place": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "kind": {
            "type": "string",
            "enum": [
